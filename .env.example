ADMIN_PASSWORD=replace-with-a-strong-admin-password
PORT=8068
HOST=0.0.0.0
# 留空时使用 Claude Agent SDK 自带的 Claude Code 运行时。
CLAUDE_COMMAND=
CLAUDE_ARGS=
# Windows 原生环境不支持 Claude Code sandbox。仅受信任主机可显式改为 true；推荐使用 WSL2。
CLAUDE_ALLOW_UNSANDBOXED_WINDOWS=false
DATA_DIR=./data
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
WORKSPACE_ROOT=./workspaces
SEED_DEMO_USERS=false

# 公网反向代理时填写精确来源，多个值用逗号分隔。
# ALLOWED_ORIGINS=https://claude.example.com
COOKIE_SECURE=false
SESSION_TTL_MS=43200000
MAX_BODY_SIZE=2097152

MAX_CONCURRENT_TURNS=4
MAX_CONCURRENT_TURNS_PER_TEAM=2
MAX_CONCURRENT_TURNS_PER_USER=1
MODEL_CONTEXT_TOKENS=1000000
AUTO_COMPACT_RATIO=0.62
AUTO_COMPACT_ENABLED=true

# 多个工具名用逗号分隔；留空时由每个会话逐次审批。
MCP_TOOL_ALLOWLIST=

# MaxCompute 表血缘的首次启动默认值。AccessKey 请在“系统设置 → 数据同步”中填写。
MAXCOMPUTE_ENABLED=false
MAXCOMPUTE_PROJECT=
MAXCOMPUTE_COMMAND=odpscmd
# 一般留空；服务会为每次任务生成独立的临时 odps_config.ini。
MAXCOMPUTE_ARGS=
# Asia/Shanghai；管理员也可在“系统设置 → 数据同步”调整并手动触发。
MAXCOMPUTE_SCHEDULE_TIME=06:15

# 可选：32 字节随机值的 Base64。生产环境建议显式设置并放入部署密钥管理；
# 留空时服务会在 DATA_DIR/credential.key 自动生成 0600 密钥文件。
# 生成示例：openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
